# Copy this file to .env and fill in the values

APP_ENV=development

# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://socialhub:secret@localhost:5432/socialhub

# Redis connection
REDIS_URL=redis://localhost:6379/0

# Fernet encryption key for storing platform credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Public base URL (webhooks + connect callback + media relay fallback)
WEBHOOK_BASE_URL=https://your-public-url.example.com

# Upstream Instagram provider (internal only — never expose in public API/docs)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api
ZERNIO_DEFAULT_PROFILE_ID=
ZERNIO_MEDIA_CDN_BASE=https://media.zernio.com
ZERNIO_WEBHOOK_SECRET=

# Public Codenegar URLs (preferred over WEBHOOK_BASE_URL when set)
SOCIAL_CONNECT_CALLBACK_BASE_URL=
SOCIAL_MEDIA_RELAY_BASE_URL=
